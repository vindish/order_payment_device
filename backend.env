# Local non-Docker development overrides for the backend.
# Pydantic Settings reads `.env` from CWD by default; rename or symlink this
# file to `backend/.env` if you want it auto-loaded outside Docker. Inside
# Docker, environment variables come from `docker/docker-compose.yml`.

ENV=dev
SECRET_KEY=change-me-but-at-least-16-chars
DATABASE_URL=postgresql+psycopg2://app:app123@localhost:5432/app_db

REDIS_HOST=localhost
REDIS_PORT=6379

MQTT_HOST=localhost
MQTT_PORT=1883

CELERY_BROKER_URL=amqp://app:app123@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

PAYMENT_CALLBACK_TOKEN=replace-with-provider-secret
PAYMENT_SIGNING_SECRET=replace-with-payment-signing-secret
OUT_TRADE_NO_PREFIX=OPD-

ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
