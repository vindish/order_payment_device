# Compose looks up these variables in `.env` next to the docker-compose.yml
# (or in the shell environment). Copy this file to `.env` at the project
# root for local Docker runs.

# --- Admin bootstrap ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- App secrets ---
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# --- Payment ---
PAYMENT_CALLBACK_TOKEN=replace-with-provider-secret
PAYMENT_SIGNING_SECRET=replace-with-payment-signing-secret

# --- Frontend build-time API base ---
# When the frontend container is rebuilt, this URL gets baked into the JS
# bundle. Override when serving from a non-default host/port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
