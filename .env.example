ENV=dev
APP_NAME=Order Payment Device
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=postgresql+psycopg2://app:app123@localhost:5432/app_db

REDIS_HOST=localhost
REDIS_PORT=6379

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

PAYMENT_CALLBACK_TOKEN=replace-with-provider-secret
PAYMENT_SIGNING_SECRET=replace-with-payment-signing-secret
OUT_TRADE_NO_PREFIX=OPD-

# WeChat Pay APIv3. Public key is the platform certificate's public key (PEM body or single-line base64).
# WECHAT_PAY_PUBLIC_KEY=
# WECHAT_PAY_API_V3_KEY=replace-with-32-byte-apiv3-key
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=

# Alipay public key (PEM body or single-line base64) and merchant app id.
# ALIPAY_PUBLIC_KEY=
# ALIPAY_APP_ID=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
